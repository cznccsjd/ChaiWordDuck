# 测试环境配置
APP_NAME=ChaiWord Duck API (Test)
APP_VERSION=0.1.0
APP_ENV=testing
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8001

# 集成测试数据库 (Docker Compose db_test服务)
DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/chaiword_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Redis测试
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# JWT配置（测试用短期token）
JWT_SECRET_KEY=test-secret-key-for-testing-only-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 密码加密配置（测试用较低rounds）
PASSWORD_BCRYPT_ROUNDS=4

# 限流配置（测试时放宽限制）
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_HOUR=10000

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# 查询限制
GUEST_DAILY_LIMIT=10
FREE_USER_DAILY_LIMIT=30
PREMIUM_USER_DAILY_LIMIT=999999

# 收藏限制
FREE_USER_FAVORITE_LIMIT=100
PREMIUM_USER_FAVORITE_LIMIT=999999

# 日志配置
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# 其他
TIMEZONE=Asia/Shanghai
