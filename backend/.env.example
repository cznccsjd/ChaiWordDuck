# 应用配置
APP_NAME=ChaiWord Duck API
APP_VERSION=0.1.0
APP_ENV=development  # development | production | testing
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chaiword_duck
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false  # 生产环境设置为false

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 密码加密配置
PASSWORD_BCRYPT_ROUNDS=12

# 限流配置
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=1000

# OpenAI API配置
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=10

# 邮件服务配置 (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@chaiwordduck.com
FROM_NAME=拆词鸭

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# 查询限制
GUEST_DAILY_LIMIT=1
FREE_USER_DAILY_LIMIT=3
PREMIUM_USER_DAILY_LIMIT=999999

# 收藏限制
FREE_USER_FAVORITE_LIMIT=10
PREMIUM_USER_FAVORITE_LIMIT=999999

# 日志配置
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text

# Sentry错误监控 (可选)
SENTRY_DSN=

# 其他
TIMEZONE=Asia/Shanghai
