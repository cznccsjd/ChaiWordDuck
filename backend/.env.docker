# Docker环境配置文件
# 使用方法: docker-compose --env-file .env.docker up

# 应用配置
APP_NAME=ChaiWord Duck API
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (Docker容器网络)
DATABASE_URL=postgresql+asyncpg://postgres:password@chaiword_db:5432/chaiword_duck
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis配置 (Docker容器网络)
REDIS_URL=redis://chaiword_redis:6379/0
REDIS_PASSWORD=

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-docker-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 密码加密配置
PASSWORD_BCRYPT_ROUNDS=12

# 限流配置
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=1000

# AI服务配置
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=30
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=30

# AI生成限额配置
GUEST_AI_GENERATION_LIMIT=5
FREE_USER_AI_GENERATION_LIMIT=20
PREMIUM_USER_AI_GENERATION_LIMIT=-1

# 邮件服务配置
SENDGRID_API_KEY=${SENDGRID_API_KEY}
FROM_EMAIL=noreply@chaiwordduck.com
FROM_NAME=拆词鸭

# CORS配置 (Docker环境)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# 查询限制
GUEST_DAILY_LIMIT=10
FREE_USER_DAILY_LIMIT=50
PREMIUM_USER_DAILY_LIMIT=-1

# 收藏限制
FREE_USER_FAVORITE_LIMIT=10
PREMIUM_USER_FAVORITE_LIMIT=999999

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry错误监控
SENTRY_DSN=${SENTRY_DSN}

# 其他
TIMEZONE=Asia/Shanghai