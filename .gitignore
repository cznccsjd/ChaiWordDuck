.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ===========================
# Build & Logs
# ===========================
# Build artifacts
*.log
logs/
*.pid
*.seed
*.pid.lock
.tmp/
temp/
tmp/

# Compiled output
/dist
/build
*.min.js
*.min.css

# ===========================
# Testing
# ===========================
.nyc_output/
coverage/
*.lcov

# Test results and screenshots (Playwright, Cypress, etc.)
test-results/
playwright-report/
test-results.xml
junit.xml

# Test screenshots and images
**/test-results/**/*.png
**/test-results/**/*.jpg
**/test-results/**/*.jpeg
**/test-results/**/*.gif
**/test-results/**/*.webp
**/test-results/**/*.svg
**/test-results/**/screenshot*
**/test-results/**/trace*
**/test-results/**/video*

# Temporary test files
*.test.tmp
*.test.temp
test-temp/
temp-test/
frontend/test-results/

# ===========================
# Project Specific
# ===========================
# API keys and secrets (HIGH PRIORITY SECURITY)
secrets/
*.key
*.pem
credentials.json
*.api
api_keys.txt
secrets.txt
config/secrets/
**/config/secrets/

# Prevent any test files containing API keys or credentials
**/test_*_api.py
**/test_*_keys.py
**/test_*_secrets.py
**/test_*_credentials.py

# Prevent any files with "API" in the name from being committed (review manually)
**/test_*api*.py
**/config_api*.py
**/api_config*.py
**/api_keys*.py
**/gemini_api*.py

# Environment files containing sensitive data
.env.*
!.env.example

# Local development files
.local/
local/

# Documentation build files
docs/_build/
site/

# Database files
*.sqlite
*.sqlite3
*.db

# ===========================
# Miscellaneous
# ===========================
*.bak
*.backup
*.orig
*.rej
*.diff
*.patch
tsconfig.tsbuildinfo
nul

# ===========================
# Claude AI Local Settings
# ===========================
.claude/settings.local.json

